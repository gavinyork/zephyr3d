"#version 300 es
precision highp float;
precision highp int;
struct zStruct0 {
  vec2 nearFar;
};
layout(std140) uniform ch_block_name_zUBF_0_0 { zStruct0 zUBF_0_0; };
layout(location = 0) out vec4 zFSOutput_color;
void main() {
  const float d = 0.5;
  float lin = (zUBF_0_0.nearFar.x * zUBF_0_0.nearFar.y) / mix(zUBF_0_0.nearFar.y,zUBF_0_0.nearFar.x,d);
  float nonlin = (zUBF_0_0.nearFar.y - ((zUBF_0_0.nearFar.x * zUBF_0_0.nearFar.y) / lin)) / (zUBF_0_0.nearFar.y - zUBF_0_0.nearFar.x);
  float norm = zUBF_0_0.nearFar.x / mix(zUBF_0_0.nearFar.y,zUBF_0_0.nearFar.x,d);
  zFSOutput_color = vec4(lin,nonlin,norm,1.0);
}
"
`;

