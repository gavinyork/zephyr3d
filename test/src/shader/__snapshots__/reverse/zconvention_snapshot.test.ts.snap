  let nonLinearDepth: f32 = ((cameraNearFar.x / linearDepth) - cameraNearFar.y) / (cameraNearFar.x - cameraNearFar.y);
  let clipSpacePos: vec4<f32> = vec4<f32>((uv * 2.0) - vec2<f32>(1.0),(clamp(nonLinearDepth,0.0,1.0) * 2.0) - 1.0,1.0);
  let wPos: vec4<f32> = mat * clipSpacePos;
  return vec4<f32>(wPos.xyz / wPos.w,linearDepth);
}
@fragment fn main() -> zFSOutput {
  let uv: vec2<f32> = vec2<f32>(0.5);
  zFSOutputCpy.zFSOutput_color = zSamplePositionFromDepth(uv,zUBF_0_0.nearFar,zUBF_0_0.invViewProj);
  return zFSOutputCpy;
}
"
`;

