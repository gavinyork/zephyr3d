exports[`depth convention status-quo shader snapshots ShaderHelper.samplePositionFromDepth reconstruction (webgl2): webgl2-reconstruct-fs 1`] = `
"#version 300 es
precision highp float;
precision highp int;
struct zStruct0 {
  mat4 invViewProj;
  vec2 nearFar;
};
uniform highp sampler2D depthTex;
layout(std140) uniform ch_block_name_zUBF_0_0 { zStruct0 zUBF_0_0; };
layout(location = 0) out vec4 zFSOutput_color;
vec4 zSamplePositionFromDepth(vec2 uv,vec2 cameraNearFar,mat4 mat) {
  float linearDepth = textureLod(depthTex,uv,0.0).r;
  float nonLinearDepth = ((cameraNearFar.x / linearDepth) - cameraNearFar.y) / (cameraNearFar.x - cameraNearFar.y);
  vec4 clipSpacePos = vec4((uv * 2.0) - vec2(1.0),(clamp(nonLinearDepth,0.0,1.0) * 2.0) - 1.0,1.0);
  vec4 wPos = mat * clipSpacePos;
  return vec4(wPos.xyz / wPos.w,linearDepth);
}
void main() {
  const vec2 uv = vec2(0.5);
  zFSOutput_color = zSamplePositionFromDepth(uv,zUBF_0_0.nearFar,zUBF_0_0.invViewProj);
}
"
`;

