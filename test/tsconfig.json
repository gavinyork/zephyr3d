{
  "compilerOptions": {
    "moduleResolution": "bundler",
    "target": "ESNext",
    "module": "ESNext",
    "lib": ["ES2020", "DOM"],
    "strict": true,
    "noImplicitAny": false,
    "preserveConstEnums": false,
    "listEmittedFiles": true,
    "noUnusedLocals": true,
    "strictNullChecks": false,
    "allowSyntheticDefaultImports": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": false,
    "sourceMap": true,
    "stripInternal": true,
    "types": ["jest", "node"],
    "paths": {
      // Mirrors the jest moduleNameMapper entries so tests typecheck against the
      // same sources jest loads at runtime. Required for packages consumed from
      // source, and for any package imported by one of them (their own folders
      // have no node_modules to resolve through).
      "@zephyr3d/backend-null": ["../libs/backend-null/src"],
      "@zephyr3d/base": ["../libs/base/src"],
      "@zephyr3d/modelgen": ["../libs/modelgen/src"],
      "@zephyr3d/procgen": ["../libs/procgen/src"]
    }
  },
  "exclude": ["node_modules", "**/*.spec.ts", "**/*.d.ts", "common/temp", "**/common/temp"]
}
