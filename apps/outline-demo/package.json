{
  "name": "@zephyr3d/outline-demo",
  "version": "0.0.1",
  "description": "RenderPipeline and ProxyDrawable object outline demo",
  "private": "true",
  "scripts": {
    "clean": "shx rm -rf dist .tsbuildinfo",
    "build:check": "tsc -p . --noEmit",
    "build": "cross-env NODE_OPTIONS=--max_old_space_size=8192 rollup -c --silent",
    "serve": "web-dev-server --no-cache --watch --open dist/index.html"
  },
  "devDependencies": {
    "@rollup/plugin-node-resolve": "~16.0.0",
    "@swc/core": "^1.3.62",
    "@web/dev-server": "^0.1.35",
    "cross-env": "^7.0.3",
    "rollup": "~4.30.1",
    "rollup-plugin-copy": "^3.4.0",
    "rollup-plugin-swc3": "~0.12.1",
    "shx": "^0.3.4",
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "@webgpu/types": "^0.1.65",
    "@zephyr3d/backend-webgl": "workspace:^0.1.16",
    "@zephyr3d/base": "workspace:^0.2.9",
    "@zephyr3d/device": "workspace:^0.2.17",
    "@zephyr3d/scene": "workspace:^0.9.23"
  }
}
