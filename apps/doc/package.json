{
  "name": "@zephyr3d/doc",
  "version": "0.0.1",
  "description": "zephyr3d documentations and showcase",
  "homepage": "https://github.com/gavinyork/zephyr3d#readme",
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gavinyork/zephyr3d.git"
  },
  "scripts": {
    "build:doc": "node build-doc.js 2>&1",
    "build:showcase": "cross-env NODE_OPTIONS=--max_old_space_size=8192 rollup -c rollup.config.showcase.mjs --silent",
    "build:static": "shx mkdir -p web/public/css web/public/js && shx cp web/showcase.html web/showdemo.html web/demo.html web/favicon.ico web/public && shx cp web/css/bootstrap.min.css web/public/css && shx cp web/js/bootstrap.min.js web/public/js",
    "build:libs": "cross-env NODE_OPTIONS=--max_old_space_size=8192 rollup -c rollup.config.libs.mjs --silent",
    "build:tutorials": "npm run build:libs && cross-env NODE_OPTIONS=--max_old_space_size=8192 rollup -c --silent",
    "build:vitepress": "cross-env DOC_BASE=/doc/ NODE_OPTIONS=--max_old_space_size=8192 vitepress build web",
    "build:web": "npm run build:static && npm run build:showcase && npm run build:tutorials && npm run build:vitepress",
    "build:site": "shx rm -rf dist web/api && shx rm -f .buildcache.tmp.json && npm run build:doc && npm run build:web",
    "clean:cache": "shx rm -f .buildcache.json .buildcache.tmp.json .libcache.json",
    "build:check": "tsc -p . --noEmit",
    "deploy": "npm run build:site && shx rm -rf ../homepage/doc && shx cp -R dist/web ../homepage/doc",
    "lint": "cross-env NODE_OPTIONS=--max_old_space_size=8192 eslint \"src/**/*.js\" -f compact",
    "lint-fix": "cross-env NODE_OPTIONS=--max_old_space_size=8192 eslint --fix \"src/**/*.ts\" -f compact",
    "dev": "node dev.mjs",
    "dev:vitepress": "cross-env DOC_BASE=/doc/ vitepress dev web --host 0.0.0.0",
    "dev:tutorials": "node watch-tutorials.mjs",
    "dev:showcase": "rollup -c rollup.config.showcase.mjs --watch",
    "serve": "cross-env DOC_BASE=/doc/ vitepress preview web --host 0.0.0.0"
  },
  "engines": {
    "node": ">=16.18.0"
  },
  "devDependencies": {
    "@microsoft/api-extractor": "^7.34.4",
    "@microsoft/api-documenter": "^7.21.6",
    "yargs": "^17.7.1",
    "cross-spawn": "^7.0.3",
    "chalk": "^5.2.0",
    "@web/dev-server": "^0.1.35",
    "@babel/core": "^7.20.12",
    "@babel/preset-env": "^7.20.2",
    "@rollup/plugin-node-resolve": "~16.0.0",
    "@rollup/plugin-strip": "~3.0.4",
    "@rollup/plugin-terser": "~0.4.4",
    "@rollup/plugin-commonjs": "~28.0.2",
    "rollup-plugin-typescript2": "^0.34.1",
    "rollup-plugin-import-css": "~3.5.8",
    "@rollup/pluginutils": "~5.1.4",
    "rollup": "~4.30.1",
    "rollup-plugin-dts": "~6.1.1",
    "rollup-plugin-copy": "^3.4.0",
    "@swc/core": "^1.3.62",
    "rollup-plugin-swc3": "~0.12.1",
    "globals": "^16.4.0",
    "replace": "^1.2.2",
    "run-script-os": "^1.1.6",
    "shx": "^0.3.4",
    "cross-env": "^7.0.3",
    "typescript": "^5.7.3",
    "tslib": "^2.8.1",
    "eslint": "~9.38.0",
    "@eslint/js": "~9.38.0",
    "@typescript-eslint/parser": "~8.46.1",
    "@typescript-eslint/eslint-plugin": "~8.46.1",
    "prettier": "~3.6.2",
    "vitepress": "^1.6.4",
    "search-insights": "^2.0.0",
    "vue": "^3.5.25",
    "eslint-plugin-prettier": "~5.5.4",
    "eslint-config-prettier": "~10.1.8",
    "eslint-plugin-import": "~2.32.0",
    "eslint-import-resolver-typescript": "~4.4.4",
    "eslint-plugin-tsdoc": "~0.4.0",
    "eslint-formatter-compact": "~8.40.0",
    "typedoc": "~0.28.19",
    "typedoc-plugin-markdown": "~4.12.0",
    "typedoc-vitepress-theme": "~1.1.3"
  },
  "dependencies": {
    "@types/diff": "^5.0.2",
    "@webgpu/types": "^0.1.65",
    "@types/draco3d": "^1.4.9",
    "draco3d": "^1.5.7",
    "diff": "^5.0.0",
    "highlight.js": "^11.8.0",
    "bootstrap": "^5.3.1",
    "lil-gui": "^0.19.2",
    "@zip.js/zip.js": "^2.7.54",
    "@popperjs/core": "^2.11.8",
    "@zephyr3d/base": "workspace:^0.2.9",
    "@zephyr3d/device": "workspace:^0.2.18",
    "@zephyr3d/scene": "workspace:^0.9.25",
    "@zephyr3d/loaders": "workspace:^0.1.4",
    "@zephyr3d/imgui": "workspace:^0.2.7",
    "@zephyr3d/backend-webgl": "workspace:^0.1.16",
    "@zephyr3d/backend-webgpu": "workspace:^0.1.20"
  }
}
