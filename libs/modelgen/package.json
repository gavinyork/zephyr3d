{
  "name": "@zephyr3d/modelgen",
  "version": "0.1.1",
  "description": "Dependency-free procedural mesh generator for zephyr3d",
  "homepage": "https://github.com/gavinyork/zephyr3d#readme",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "**/*.js",
    "**/*.d.ts",
    "**/*.js.map"
  ],
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gavinyork/zephyr3d.git"
  },
  "scripts": {
    "clean": "shx rm -rf ./dist .tsbuildinfo",
    "build:check": "tsc -p . --noEmit",
    "lint": "cross-env NODE_OPTIONS=--max_old_space_size=8192 eslint \"src/**/*.ts\" -f compact",
    "lint-fix": "cross-env NODE_OPTIONS=--max_old_space_size=8192 eslint --fix \"src/**/*.ts\" -f compact",
    "build": "cross-env NODE_OPTIONS=--max_old_space_size=8192 rollup -c --silent"
  },
  "keywords": [
    "javascript",
    "3d",
    "procedural",
    "mesh",
    "generator",
    "zephyr3d"
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/gavinyork/zephyr3d/issues"
  },
  "engines": {
    "node": ">=16.18.0"
  },
  "devDependencies": {
    "@eslint/js": "~9.38.0",
    "@rollup/plugin-node-resolve": "~16.0.0",
    "@rollup/pluginutils": "~5.1.4",
    "@swc/core": "^1.3.62",
    "@typescript-eslint/eslint-plugin": "~8.46.1",
    "@typescript-eslint/parser": "~8.46.1",
    "cross-env": "^7.0.3",
    "eslint": "~9.38.0",
    "eslint-config-prettier": "~10.1.8",
    "eslint-formatter-compact": "~8.40.0",
    "eslint-import-resolver-typescript": "~4.4.4",
    "eslint-plugin-import": "~2.32.0",
    "eslint-plugin-prettier": "~5.5.4",
    "eslint-plugin-tsdoc": "~0.4.0",
    "globals": "^16.4.0",
    "prettier": "~3.6.2",
    "rollup": "~4.30.1",
    "rollup-plugin-dts": "~6.1.1",
    "rollup-plugin-swc3": "~0.12.1",
    "shx": "^0.3.4",
    "typescript": "^5.7.3"
  },
  "dependencies": {}
}
