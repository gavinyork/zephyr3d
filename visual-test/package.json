{
  "name": "@zephyr3d/visual-test",
  "version": "0.0.1",
  "description": "Pixel regression harness: renders deterministic scenes across RHI backends and compares against committed baselines",
  "homepage": "https://github.com/gavinyork/zephyr3d#readme",
  "private": "true",
  "type": "module",
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gavinyork/zephyr3d.git"
  },
  "scripts": {
    "clean": "shx rm -rf dist .tsbuildinfo test-results playwright-report",
    "build:check": "tsc -p . --noEmit",
    "build": "cross-env NODE_OPTIONS=--max_old_space_size=8192 rollup -c --silent",
    "lint": "cross-env NODE_OPTIONS=--max_old_space_size=8192 eslint \"src/**/*.ts\" \"tests/**/*.ts\" -f compact",
    "lint-fix": "cross-env NODE_OPTIONS=--max_old_space_size=8192 eslint --fix \"src/**/*.ts\" \"tests/**/*.ts\" -f compact",
    "install-browser": "playwright install --with-deps chromium",
    "test": "npm run build && npm run test:only",
    "test:only": "playwright test --project=webgl2-swiftshader --project=webgpu-swiftshader",
    "test:gpu": "npm run build && playwright test --project=webgl2-gpu --project=webgpu-gpu",
    "test:update": "cross-env UPDATE_BASELINES=1 npm run test",
    "sensitivity": "node tools/sensitivity.mjs",
    "report": "playwright show-report"
  },
  "engines": {
    "node": ">=16.18.0"
  },
  "devDependencies": {
    "@eslint/js": "~9.38.0",
    "@playwright/test": "~1.62.1",
    "@rollup/plugin-node-resolve": "~16.0.0",
    "@rollup/pluginutils": "~5.1.4",
    "@swc/core": "^1.3.62",
    "@types/node": "^22.12.0",
    "@types/pixelmatch": "^5.2.6",
    "@types/pngjs": "^6.0.5",
    "@typescript-eslint/eslint-plugin": "~8.46.1",
    "@typescript-eslint/parser": "~8.46.1",
    "@webgpu/types": "^0.1.65",
    "cross-env": "^7.0.3",
    "eslint": "~9.38.0",
    "eslint-config-prettier": "~10.1.8",
    "eslint-formatter-compact": "~8.40.0",
    "eslint-import-resolver-typescript": "~4.4.4",
    "eslint-plugin-import": "~2.32.0",
    "eslint-plugin-prettier": "~5.5.4",
    "globals": "^16.4.0",
    "pixelmatch": "^5.3.0",
    "pngjs": "^7.0.0",
    "prettier": "~3.6.2",
    "rollup": "~4.30.1",
    "rollup-plugin-copy": "^3.4.0",
    "rollup-plugin-swc3": "~0.12.1",
    "shx": "^0.3.4",
    "tslib": "^2.8.1",
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "@zephyr3d/backend-webgl": "workspace:^0.1.17",
    "@zephyr3d/backend-webgpu": "workspace:^0.1.21",
    "@zephyr3d/base": "workspace:^0.2.10",
    "@zephyr3d/device": "workspace:^0.2.19",
    "@zephyr3d/loaders": "workspace:^0.1.5",
    "@zephyr3d/scene": "workspace:^0.9.26"
  }
}
